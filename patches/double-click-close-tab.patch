+bool IsTopNonClientHitTest(WPARAM hit_test) {
+  switch (hit_test) {
+    case HTCAPTION:
+    case HTTOP:
+    case HTTOPLEFT:
+    case HTTOPRIGHT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsClientPointInTopTabStripArea(HWND hwnd,
+                                    BrowserView* browser_view,
+                                    BrowserWidget* browser_widget,
+                                    LPARAM l_param) {
+  if (!browser_view || !browser_widget || !browser_widget->GetFrameView()) {
+    return false;
+  }
+
+  const gfx::Point pixel_point(CR_GET_X_LPARAM(l_param),
+                               CR_GET_Y_LPARAM(l_param));
+  const gfx::Point dip_point =
+      display::win::GetScreenWin()->ClientToDIPPoint(hwnd, pixel_point);
+  const int tab_strip_bottom =
+      GetTopAreaHeight(browser_widget->GetFrameView()) +
+      browser_view->GetFrameElementInfo().tabstrip_preferred_height;
+
+  return dip_point.y() >= 0 && dip_point.y() <= tab_strip_bottom;
+}
+
+bool CanCloseActiveTab(BrowserWindowInterface* browser) {
+  return browser && browser->GetTabStripModel() &&
+         browser->GetTabStripModel()->count() > 1;
+}
